# Copy to platform-runtime.yaml, edit, and apply to the workload cluster.
# Version values mirror releases.yaml. This ConfigMap contains no credentials.
apiVersion: v1
kind: ConfigMap
metadata:
  name: platform-runtime
  namespace: flux-system
data:
  INGRESS_CHART_REPOSITORY: https://kubernetes.github.io/ingress-nginx
  INGRESS_CHART_VERSION: 4.15.1
  # Build app/Dockerfile and publish to your registry; use the resulting digest.
  DEMO_IMAGE: registry.example.com/demo@sha256:REPLACE_DIGEST
  POSTGRES_DEMO_IMAGE: registry.example.com/demo@sha256:REPLACE_DIGEST
  LOAD_BALANCER_SOURCE_RANGES: '["203.0.113.10/32"]'
  DATABASE_CHART_REPOSITORY: https://cloudnative-pg.github.io/charts
  DATABASE_OPERATOR_CHART_VERSION: 0.29.1
  DATABASE_PLUGIN_CHART_VERSION: 0.8.1
  CERT_MANAGER_CHART_REPOSITORY: https://charts.jetstack.io
  CERT_MANAGER_CHART_VERSION: v1.21.2
  POSTGRES_IMAGE: ghcr.io/cloudnative-pg/postgresql:18.6-system-trixie
  # Unique per cluster/database lifetime, including replacements in the same bucket.
  BACKUP_PREFIX: replace-with-unique-cluster-prefix
