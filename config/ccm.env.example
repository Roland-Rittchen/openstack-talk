# Copy to ccm.env, edit, then `set -a; . config/ccm.env; set +a` before rendering.
CLOUD_CONTROLLER_IMAGE=registry.k8s.io/provider-os/openstack-cloud-controller-manager:v1.35.0
CLUSTER_NAME=replace-with-unique-workload-cluster-name
# Use cloud-node,cloud-node-lifecycle when Octavia is unavailable (Local).
CLOUD_CONTROLLERS=cloud-node,cloud-node-lifecycle,service
# From the workload API's kubernetes EndpointSlice; reachable from hostNetwork.
CONTROL_PLANE_PRIVATE_IP=REPLACE_PRIVATE_CONTROL_PLANE_IP
