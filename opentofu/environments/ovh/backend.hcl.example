# Copy to backend.hcl after the first local-state apply has created the bucket.
# Credentials come from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, not this file.
bucket                      = "REPLACE_STATE_BUCKET_FROM_OUTPUTS"
key                         = "platform.tfstate"
region                      = "REPLACE_S3_REGION"
endpoints                   = { s3 = "https://s3.example.com" }
use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_lockfile                = true
# Probe encryption support before enabling it on a non-AWS endpoint.
encrypt                     = false
